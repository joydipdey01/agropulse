# ─────────────────────────────────────────────────────────────
# AgroPulse Precision — environment variables
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
# These two are PUBLIC by design (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only. Never prefix with NEXT_PUBLIC_. Used only for distributed rate limiting.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — server only. https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the Groq model (default shown)
GROQ_MODEL=openai/gpt-oss-120b

# SECRET — server only. Create an API key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
